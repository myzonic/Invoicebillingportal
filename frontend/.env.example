# Frontend environment configuration
# Copy to .env and adjust. Vite exposes only VITE_* vars to the browser.
# Leave VITE_API_URL empty when using the dev proxy (/api on the same origin).

# Backend API root. In development the vite proxy forwards /api -> http://localhost:3001
VITE_API_URL=

# Optional development-only branding fallbacks. Production branding is served
# by the backend from PORTAL_*, COMPANY_*, PAYMENT_HOST, and PUBLIC_LOGO_URL.
VITE_PORTAL_NAME=Billing Portal
VITE_PORTAL_TAGLINE=Finance & Billing
VITE_COMPANY_NAME=Your Company
VITE_PAYMENT_HOST=localhost:5173
VITE_PAYMENT_URL=http://localhost:5173
VITE_PUBLIC_LOGO_URL=
VITE_DEFAULT_BRAND_NAME=Your Company
