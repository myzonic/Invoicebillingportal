# Myzonic Finance & Billing - environment template
# Single-app deploy: one container serves the API + the built frontend + uploads.
#
# Two ways to use this:
#   1) Docker Compose (reference / local test): copy to `.env`, then `docker compose up`.
#   2) Dokploy: set the same variables in the app's Environment tab and build the
#      root Dockerfile from your Git repo. See backend/.env.example for the full list.

# --- Postgres (used by docker-compose only; on Dokploy use its PostgreSQL service) ---
POSTGRES_PASSWORD=change-me-strong-password

# --- JWT secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRES_IN=1d
REFRESH_EXPIRES_IN=30d

# Invite token used to sign up the first user (frontend /signup?token=...)
INVITE_TOKEN=change-me-invite-token

# Initial admin account (created by the seed on first boot)
SEED_ADMIN_EMAIL=admin@myzonic.com
SEED_ADMIN_PASSWORD=change-me-admin-password

# Public URLs - same domain in a single-app deploy
CLIENT_URL=https://your-domain.com
API_URL=https://your-domain.com

# --- Square ---
# sandbox while testing: https://developer.squareup.com
SQUARE_ENVIRONMENT=production
SQUARE_APP_ID=sq0idp-69IRWFqy7jws1wyTknhLhw
SQUARE_ACCESS_TOKEN=change-me
SQUARE_LOCATION_ID=change-me
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- SMTP (optional until you add email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Myzonic Finance <billing@myzonic.com>

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
