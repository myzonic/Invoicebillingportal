// Finance & Billing Portal database schema
// PostgreSQL via Prisma ORM

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModuleName {
  dashboard
  clients
  invoices
  items
  brands
  merchants
  users
  roles
  logs
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  SQUARE
  MANUAL
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum LogAction {
  CREATE
  READ
  UPDATE
  DELETE
  SEND
  LOGIN
  LOGOUT
  PAYMENT
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  avatarUrl    String?
  isActive     Boolean        @default(true)
  roleId       String
  role         Role           @relation(fields: [roleId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module       ModuleName
  canCreate    Boolean    @default(false)
  canRead      Boolean    @default(false)
  canUpdate    Boolean    @default(false)
  canDelete    Boolean    @default(false)

  @@unique([roleId, module])
  @@index([module])
}

model Brand {
  id               String   @id @default(cuid())
  name             String
  // White-label payment domain: <paymentSubdomain>.<domain>
  // e.g. "crystalwebsites.com.au" + "pay" -> https://pay.crystalwebsites.com.au
  domain           String?  @unique
  paymentSubdomain String   @default("pay")
  businessName     String?
  country          String?
  website          String?
  logoUrl          String?
  // Brand accent color used by client-facing invoice pages and PDFs.
  color            String?
  // Dominant colors extracted from the uploaded logo, e.g. ["#111827", "#d4a72c"].
  logoPalette      Json?
  // Saved per-brand invoice design: { layout, colors: { primary, secondary, accent, supporting } }.
  invoiceDesign    Json?
  currency         String   @default("USD")
  email            String?
  phone            String?
  address          String?
  pdfHeader        String?
  pdfFooter        String?
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)
  paymentEnabled   Boolean  @default(true)
  // Non-secret payment preferences, e.g. { "supportEmail": "...", "receiptNote": "..." }
  paymentSettings  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clients   Client[]
  merchants Merchant[]
  invoices  Invoice[]

  @@index([isActive])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([brandId])
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
}

model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  // Stable, non-guessable public identifier used in branded payment URLs.
  publicToken     String        @unique
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  brandId         String?
  brand           Brand?        @relation(fields: [brandId], references: [id])
  items           Json          // array of { description, quantity, unitPrice, amount }
  subtotal        Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  color           String?       // brand accent color shown on client-facing invoice/PDF
  // Optional invoice-level design override; never mutates the brand defaults.
  designOverride  Json?
  // Additive builder-only document data (shipping, terms, internal notes, etc.).
  // Existing invoices have NULL and keep their historical rendering.
  builderData     Json?
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  issueDate       DateTime
  dueDate         DateTime?
  sentAt          DateTime?
  paidAt          DateTime?
  squarePaymentLink String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments Payment[]
  quotes    PaymentQuote[]
  invoiceLogs InvoiceLog[]

  @@index([clientId])
  @@index([status])
  @@index([number])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // `amount`/`currency` are the amount actually sent to Square (always USD for
  // the US merchant account). The invoice's own amount/currency are snapshotted
  // below so a payment can always be reconciled against the original invoice.
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?       // Square payment id or manual reference
  locationId    String?       // Square location that processed the charge
  quoteId       String?       // locked FX quote used for this attempt
  invoiceAmount Decimal?      @db.Decimal(12, 2)
  invoiceCurrency String?
  exchangeRate  Decimal?      @db.Decimal(20, 10) // units of invoice currency per 1 USD
  exchangeRateProvider String?
  exchangeRateAt DateTime?
  usdAmount     Decimal?      @db.Decimal(12, 2)
  capturedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([status])
}

/// Short-lived, locked FX quote created when a client starts a payment attempt.
/// It guarantees the USD amount authorised in the browser is exactly the amount
/// recorded against the resulting Square payment.
model PaymentQuote {
  id              String   @id @default(cuid())
  token           String   @unique
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceAmount   Decimal  @db.Decimal(12, 2)
  invoiceCurrency String
  usdAmount       Decimal  @db.Decimal(12, 2)
  exchangeRate    Decimal  @db.Decimal(20, 10)
  provider        String
  rateAt          DateTime
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([invoiceId])
  @@index([expiresAt])
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  userEmail String?
  module    String
  action    LogAction
  details   Json?
  ip        String?
  createdAt DateTime   @default(now())

  @@index([module])
  @@index([createdAt])
}

model InvoiceLog {
  id        String   @id @default(cuid())
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  toEmail   String
  subject   String
  status    String // "sent" | "failed"
  error     String?
  sentAt    DateTime @default(now())

  @@index([invoiceId])
}

model InviteToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String?
  roleId    String?
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}
