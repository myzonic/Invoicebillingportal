# ===== Myzonic Portal Backend - production environment template =====
# Copy to your Dokploy service's Environment tab and fill in real values.
# Never commit real secrets.

# Port the app listens on inside the container
PORT=3000
# Public HTTPS URLs of your app (same domain for a single-app deploy)
API_URL=https://your-domain.com
CLIENT_URL=https://your-domain.com

# Dokploy PostgreSQL service connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/myzonic?schema=public

# JWT secrets - use long random strings (e.g. `openssl rand -hex 64`)
JWT_SECRET=change_me_64_hex_chars
JWT_REFRESH_SECRET=change_me_64_hex_chars
JWT_EXPIRES_IN=1d
REFRESH_EXPIRES_IN=30d

# First admin account created on first boot (seed runs on every start, is idempotent)
SEED_ADMIN_EMAIL=admin@myzonic.com
SEED_ADMIN_PASSWORD=change_me_strong_password
# Invite token used by the signup flow
INVITE_TOKEN=change_me_invite_token

# ===== Square Payments (production) =====
SQUARE_ENVIRONMENT=production
# Production Application ID (from Square Developer Dashboard)
SQUARE_APP_ID=sq0idp-69IRWFqy7jws1wyTknhLhw
# Live access token + location of the merchant's USD account (charges always run in USD)
SQUARE_ACCESS_TOKEN=EAAA_live_token
SQUARE_LOCATION_ID=LIVE_LOCATION_ID
# Optional: verify Square webhook HMAC signatures
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Optional per-currency live locations, only if you use non-USD charging accounts
# SQUARE_TOKEN_GBP=...
# SQUARE_LOCATION_GBP=...

# ===== Email (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Myzonic Finance <billing@myzonic.com>"

# ===== File uploads =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
