# ===== Billing Portal backend environment template =====
# Copy to your Dokploy service's Environment tab and fill in real values.
# Never commit real secrets.

# Port the app listens on inside the container
PORT=3000
# Public HTTPS URLs of your app (same domain for a single-app deploy)
API_URL=https://your-domain.com
CLIENT_URL=https://your-domain.com

# Dokploy PostgreSQL service connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/billing_portal?schema=public

# JWT secrets - use long random strings (e.g. `openssl rand -hex 64`)
JWT_SECRET=change_me_64_hex_chars
JWT_REFRESH_SECRET=change_me_64_hex_chars
JWT_EXPIRES_IN=1d
REFRESH_EXPIRES_IN=30d

# Public branding (served at runtime; only non-secret values are exposed)
PORTAL_NAME=Billing Portal
PORTAL_TAGLINE=Finance & Billing
COMPANY_NAME=Your Company
COMPANY_EMAIL=billing@example.com
COMPANY_WEBSITE=https://example.com
PAYMENT_HOST=pay.example.com
PAYMENT_URL=https://pay.example.com
# Optional URL for a company logo; leave empty for the neutral built-in icon.
PUBLIC_LOGO_URL=
DEFAULT_BRAND_NAME=Your Company

# First admin account created on first boot (seed runs on every start, is idempotent)
SEED_ADMIN_NAME=Portal Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_password
# Invite token used by the signup flow
INVITE_TOKEN=change_me_invite_token

# ===== Square Payments (production) =====
SQUARE_ENVIRONMENT=production
# Production Application ID (from Square Developer Dashboard)
SQUARE_APP_ID=your-square-application-id
# Live access token + location of the merchant's USD account (charges always run in USD)
SQUARE_ACCESS_TOKEN=EAAA_live_token
SQUARE_LOCATION_ID=LIVE_LOCATION_ID
# Currency the account above settles in. Charges are always computed in it.
SQUARE_DEFAULT_CURRENCY=USD
# REQUIRED: signature key of your webhook subscription. Signed requests are
# rejected without it, so a missing value intentionally fails the boot rather
# than trusting anything that can reach /api/webhooks/square.
SQUARE_WEBHOOK_SIGNATURE_KEY=change_me_webhook_signature_key
# Optional: the exact notification URL registered in the Square developer
# console. Defaults to API_URL + /api/webhooks/square.
# SQUARE_WEBHOOK_URL=https://your-domain.com/api/webhooks/square
# Optional per-currency live locations, only if you use non-USD charging accounts
# SQUARE_TOKEN_GBP=...
# SQUARE_LOCATION_GBP=...

# ===== Email (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Billing Portal <billing@example.com>"

# ===== File uploads =====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
